<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="terminal_settings"
        app:title="@string/termux_terminal_view_terminal_header">

        <SwitchPreferenceCompat
            app:key="terminal_margin_adjustment"
            app:summaryOff="@string/termux_terminal_view_terminal_margin_adjustment_off"
            app:summaryOn="@string/termux_terminal_view_terminal_margin_adjustment_on"
            app:title="@string/termux_terminal_view_terminal_margin_adjustment_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="wallpaper"
        app:title="@string/termux_terminal_view_wallpaper_header">

        <SeekBarPreference
            app:key="background_overlay_opacity"
            app:title="@string/termux_terminal_view_background_overlay_opacity_title"
            app:summary="@string/termux_terminal_view_background_overlay_opacity_summary"
            android:min="0"
            android:max="100"
            app:defaultValue="35"
            app:showSeekBarValue="true" />

        <Preference
            app:key="restore_background_overlay_opacity"
            app:title="@string/termux_terminal_view_background_overlay_opacity_restore_title"
            app:summary="@string/termux_terminal_view_background_overlay_opacity_restore_summary" />

    </PreferenceCategory>

</PreferenceScreen>
